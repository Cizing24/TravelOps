RELEASE_TAG=REPLACE_WITH_TESTED_COMMIT_SHA
DEMO_HOST=REPLACE_WITH_CONTROLLED_PUBLIC_HOST
APP_NAME=TravelOps
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_CONTROLLED_PUBLIC_HOST
APP_KEY=base64:REPLACE_WITH_RANDOM_32_BYTE_KEY_BASE64
APP_LOCALE=zh_TW
TRAVELOPS_DEMO=true
TRAVELOPS_PUBLIC_DEMO=true
TRAVELOPS_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=travelops_public_demo
DB_USERNAME=travelops_runtime
DB_PASSWORD=REPLACE_WITH_RUNTIME_DB_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SEPARATE_MIGRATOR_SECRET
MYSQL_MIGRATOR_PASSWORD=REPLACE_WITH_DISTINCT_MIGRATOR_SECRET
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_SECRET
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_LIFETIME=60
# One-time provisioning job only; remove from running services after provisioning.
DEMO_PROVISION_CONFIRM=CREATE_SYNTHETIC_DEMO
DEMO_OPERATOR_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_PASSWORD_24_CHARS_OR_MORE
DEMO_CUSTOMER_PASSWORD=REPLACE_WITH_DIFFERENT_CUSTOMER_SECRET_24_CHARS_OR_MORE
DEMO_MERCHANT_PASSWORD=REPLACE_WITH_DIFFERENT_MERCHANT_SECRET_24_CHARS_OR_MORE
DEMO_POS_PASSWORD=REPLACE_WITH_DIFFERENT_POS_SECRET_24_CHARS_OR_MORE
