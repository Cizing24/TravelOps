APP_NAME=TravelOps
APP_ENV=local
# APP_KEY is created locally or loaded from the Compose runtime volume.
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=zh_TW

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=travelops_demo
DB_USERNAME=travelops_demo
DB_PASSWORD=travelops-local-db

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
TRAVELOPS_DEMO=true
# TRAVELOPS_WEBHOOK_SECRET is generated for the local Demo.
